# EditorConfig — https://editorconfig.org
# Mirrors the Prettier config (tabs, LF) so editors and the formatter agree.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

# YAML and JSON-ish data files conventionally use spaces.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown: keep trailing whitespace (hard line breaks are significant).
[*.md]
trim_trailing_whitespace = false

# Rust uses spaces (rustfmt default).
[*.rs]
indent_style = space
indent_size = 4
